# Secrets: never commit. Templates (*.example) are the exception.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.pem

# Dependencies
node_modules/

# Wrangler / Miniflare local state (local D1 database, build output)
.wrangler/
.mf/

# Build, test and job output
dist/
coverage/
out/

# Logs
*.log
npm-debug.log*

# Personal Claude Code settings (shared settings.json is committed)
.claude/settings.local.json

# OS and editor files
.DS_Store
.vscode/
.idea/
