{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dashboard",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		// Only the API runs the Worker; every other path is served straight from public/.
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		// The first `npm run deploy` created the database and wrote its id here.
		{
			"binding": "DB",
			"database_name": "dashboard",
			"migrations_dir": "migrations",
			"database_id": "991512c6-7bd0-4c69-9a6f-123c96faf985"
		}
	]
	// Secrets (docs/SETUP.md), set with `npx wrangler secret put`: PRINTER_TOKEN,
	// LOGIN_PASSWORD and SESSION_SECRET. Until they're set, the deployed API answers 503.
}