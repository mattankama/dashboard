# Copy to .env (git-ignored) and fill in. Placeholders below are enough for dry runs
# against the local web app (`npm run dev` in apps/web).

# The Dashboard web app and its printer token (apps/web/.dev.vars locally; wrangler secret in Phase 4).
DASHBOARD_API_URL=http://localhost:8787
PRINTER_TOKEN=dev-token

# Once the web app is behind Cloudflare Access (docs/SETUP.md): a service token, so this
# job gets through. Set both or neither.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Grouping. Without a key the sheet is one plain list.
ANTHROPIC_API_KEY=

# Email through Gmail. GMAIL_APP_PASSWORD is an app password (needs 2-Step Verification),
# not the account password. NOTIFY_TO must be your own, single address.
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_TO=

# Schedule and printer (defaults shown).
PRINT_DAY=Sun
PRINT_TIME=09:00
PRINTER_NAME=CanonMF4800
